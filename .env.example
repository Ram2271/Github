PORT=5000
JWT_SECRET=super_secret_github_platform_key_2026

# MongoDB Connection
# If left commented or empty, the server automatically uses the built-in
# disk-persisted database engine (server/data/db.json) with zero configuration!
# MONGODB_URI=mongodb://localhost:27017/github_clone

# Filebase S3 Object Storage Credentials
# Sign up at https://filebase.com to get your S3-compatible API Key & Secret
# If left empty, the server uses the local storage emulator in server/storage/
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=github-repo-files
FILEBASE_ENDPOINT=https://s3.filebase.com
