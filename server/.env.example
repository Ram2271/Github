PORT=5000
JWT_SECRET=super_secret_github_platform_key_2026

# ===================================================================
# 📁 Google Drive Cloud Storage (Personal 15 GB Free Quota)
# ===================================================================
# 1. Enable "Google Drive API" in Google Cloud Console: https://console.cloud.google.com
# 2. Create an OAuth client ID (Web application, redirect: http://localhost:3000/oauth2callback)
# 3. Run: node server/scripts/get_gdrive_tokens.js <CLIENT_ID> <CLIENT_SECRET>
# 4. Create a folder in Google Drive and paste the folder ID below:
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Optional: Service Account (For Workspace Shared Drives)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/github-clone?retryWrites=true&w=majority

# ===================================================================
# 📧 Developer Gmail Configuration for 6-Digit OTP Verification
# ===================================================================
GMAIL_USER=your_personal_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
